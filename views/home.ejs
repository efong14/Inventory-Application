<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <nav>
    <nav><% - include('partials/nav.ejs') %></nav>
    </nav>
    <div class="titleBox">
      <header class="title"><%= title %></header>
      <a class="newButton" href="/new">Create New Game Entry</a>
    <sectio class="formContainer">
    <section class="displayBox">
      <div class="sortSidebar">
        <form method="GET" action="/">
          <div class="sortDate">
            <h1 class="sortHeader">Sort by Date</h1>
            <input type="radio" id="Ascending" name="sort" value="Ascending" />
            <label for="Ascending">Ascending</label>
            <input type="radio" id="Descending" name="sort" value="Descending" />
            <label for="Descending">Descending</label>
          </div>
          <div class="sortGenre">
            <h1 class="sortHeader">Sort by Genre</h1>
            <ul class="genreList">
            <% genreList.forEach((genre)=>{ %>
                <li class="genreListItem">
                     <input type="hidden" id="genreId" name="genreId" value="<%= genre.id %>" >
                    <input type="checkbox" id="<%= genre.name %>" name="genre" value="<%= genre.name %>" />
                    <label for="<%= genre.name %>"><%= genre.name %></label>
                </li>
            <% }) %>
            </ul>
          </div>
          <input type="submit" class="submitButton" value="Apply Filters">
        </form>
      </div>
      <div class="itemBox">
        <% gamesInfo.forEach((game)=>{ %>
          <div class="gameBox">
            <a href="/<%= game.id%>/details" class="gameLink"></a>
            <div class="imageBox"><img src="../public//img/game-cartridge.png" alt="Image of a game cartridge" class="gameImg"></div>
            <div class="textBox">
              <div class="gameTitle"><%= game.name %></div>
              <div class="gameDate"><%= game.date %></div>
              <div class="developer"><%= game.developer %></div>
              <div class="publisher"><%= game.publisher %></div>
            </div>
            <div class="genre"><%= game.genre %></div>  
          </div>
        <% }) %>
      </div>
    </section>
    <footer><a href="https://www.flaticon.com/free-icons/game-cartridge" title="game cartridge icons">Game cartridge icons created by Freepik - Flaticon</a></footer>
  </body>
</html>

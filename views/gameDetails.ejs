<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <nav><% - include('partials/nav.ejs') %></nav>
    <a class="returnButton" href="/">Return to All games</a>
    <div class="gameBox">
      <div class="imageBox">
        <img
          src="../public//img/game-cartridge.png"
          alt="Image of a game cartridge"
          class="gameImg"
        />
      </div>
      <div class="textBox">
        <div class="gameTitle"><%= game.name %></div>
        <div class="gameDate"><%= game.date %></div>
        <div class="developer"><%= game.developer %></div>
        <div class="publisher"><%= game.publisher %></div>
      </div>
      <div class="genre"><%= game.genre %></div>
      <div class="buttonContainer">
        <a href="/<%= game.id %>/update" class="updateButton">Update Entry</a>
        <a href="/<%= game.id %>/delete" class="deleteButton">Delete Entry</a>
      </div>
    </div>
  </body>
</html>
